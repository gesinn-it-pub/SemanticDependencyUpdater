{
	"config": {
		"process-timeout": 0,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5",
		"mediawiki/mediawiki-codesniffer": "51.0.0",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"autoload": {
		"psr-4": {
			"SDU\\": "src/"
		}
	},
	"scripts": {
		"test": [
			"@analyze",
			"@phpunit"
		],
		"test-coverage": [
			"@analyze",
			"@phpunit-coverage"
		],
		"analyze": [
			"@lint",
			"@phpcs"
		],
		"lint": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"minus-x check ."
		],
		"phpcs": "phpcs -ps -d memory_limit=2G",
		"phpcs-fix": "phpcbf -p",
		"phan": "phan --allow-polyfill-parser",
		"phpunit": [
			"Composer\\Config::disableProcessTimeout",
			"cd ${MW_INSTALL_PATH:-../..} && { [ -f tests/phpunit/generatePHPUnitConfig.php ] && { php tests/phpunit/generatePHPUnitConfig.php >/dev/null 2>&1 || true; [ -f phpunit.xml ] || printf '%s' '<phpunit><!-- generatePHPUnitConfig --></phpunit>' > phpunit.xml; } || true; } && MEDIAWIKI_HAS_INTEGRATION_TESTS=1 vendor/bin/phpunit -c extensions/SemanticDependencyUpdater/phpunit.xml.dist --bootstrap tests/phpunit/bootstrap.php"
		],
		"phpunit-coverage": "@phpunit --testdox --coverage-text --coverage-html extensions/SemanticDependencyUpdater/coverage/php --coverage-clover extensions/SemanticDependencyUpdater/coverage/php/coverage.xml",
		"post-test-coverage": [
			"sed -i 's|/var/www/html/extensions/SemanticDependencyUpdater/||g' coverage/php/coverage.xml",
			"find coverage/php -type f -name '*.html' -exec sed -i 's|/var/www/html/extensions/||g' {} +"
		],
		"minus-x": "minus-x check .",
		"minus-x-fix": "minus-x fix ."
	}
}
