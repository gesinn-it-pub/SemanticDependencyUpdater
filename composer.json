{
	"config": {
		"process-timeout": 0,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5",
		"mediawiki/mediawiki-codesniffer": "46.0.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"phpstan/phpstan": "^2.0",
		"vimeo/psalm": "^4.23"
	},
	"autoload": {
		"psr-4": {
			"SDU\\": "src/"
		}
	},
	"scripts": {
		"test": [
			"@analyze",
			"@phpunit"
		],
		"test-coverage": [
			"@analyze",
			"@phpunit-coverage"
		],
		"analyze": [
			"@lint",
			"@phpcs"
		],
		"lint": "parallel-lint . --exclude vendor --exclude node_modules",
		"phpcs": "phpcs -ps -d memory_limit=2G",
		"phpcs-fix": "phpcbf -p",
		"phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=2G",
		"phpstan-baseline": "phpstan analyse --configuration=phpstan.neon --memory-limit=2G --generate-baseline",
		"psalm": "psalm --config=psalm.xml",
		"psalm-baseline": "psalm --config=psalm.xml --set-baseline=psalm-baseline.xml",
		"phpunit": [
			"Composer\\Config::disableProcessTimeout",
			"bash -c 'cd ${MW_INSTALL_PATH:-../..} && { [ -f tests/phpunit/generatePHPUnitConfig.php ] && { php tests/phpunit/generatePHPUnitConfig.php >/dev/null 2>&1 || true; [ -f phpunit.xml ] || printf \"%s\" \"<phpunit><!-- generatePHPUnitConfig --></phpunit>\" > phpunit.xml; } || true; } && MEDIAWIKI_HAS_INTEGRATION_TESTS=1 vendor/bin/phpunit -c extensions/SemanticDependencyUpdater/phpunit.xml.dist --bootstrap tests/phpunit/bootstrap.php --testdox'"
		],
		"phpunit-coverage": "@phpunit --coverage-text --coverage-html extensions/SemanticDependencyUpdater/coverage/php --coverage-clover extensions/SemanticDependencyUpdater/coverage/php/coverage.xml",
		"post-test-coverage": [
			"sed -i 's|/var/www/html/extensions/SemanticDependencyUpdater/||g' coverage/php/coverage.xml",
			"find coverage/php -type f -name '*.html' -exec sed -i 's|/var/www/html/extensions/||g' {} +"
		],
		"minus-x": "minus-x check .",
		"minus-x-fix": "minus-x fix ."
	}
}
